{
  "name": "bobee",
  "version": "1.6.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "vitest run",
    "test:desktop": "electron scripts/smoke-desktop.cjs",
    "start": "electron .",
    "placeholders": "node scripts/make-placeholders.js",
    "dist": "electron-builder --win --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "productName": "Bobee",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "uiohook-napi": "^1.5.5"
  },
  "allowScripts": {
    "electron@45.0.0": true
  },
  "build": {
    "appId": "com.bobee.companion",
    "productName": "Bobee",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "assets/**",
      "messages.json",
      "preload-jar.js",
      "preload-settings.js"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "include": "build/installer.nsh",
      "artifactName": "Bobee-Setup-${version}.exe"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "ThatGuyPancake",
        "repo": "bobee",
        "releaseType": "release"
      }
    ]
  }
}
